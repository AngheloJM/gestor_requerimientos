# Copiar a .env.local y completar. NUNCA versionar .env.local.
# Todas las VITE_* quedan en el bundle público: no poner secretos aquí.
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
# Anon / publishable key (pública por diseño). NUNCA la service_role key.
VITE_SUPABASE_ANON_KEY=
