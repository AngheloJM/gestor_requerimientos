# Copiar a .env y completar. NUNCA versionar .env.
API_ADDR=0.0.0.0:8080
RUST_LOG=api=debug
# Supabase: usar puerto 5432 (conexión directa o pooler en modo session).
# El usuario de esta conexión debe poder ejecutar `SET ROLE authenticated` (RLS): la API
# lo verifica al arrancar y no inicia si no puede. NUNCA versionar el valor real.
DATABASE_URL=
# URL del proyecto. El JWKS (claves públicas ES256) se descarga de
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json y el `iss` esperado es {SUPABASE_URL}/auth/v1.
SUPABASE_URL=https://<project-ref>.supabase.co
# Opcional, por defecto 600 (mínimo 60).
# JWKS_REFRESH_SECS=600
# OPCIONAL, solo transición: habilita el fallback HS256 legacy. Dejar SIN definir.
# Si se define, NUNCA versionar el valor real.
# SUPABASE_JWT_SECRET=
# Orígenes del frontend permitidos (coma). Ej. dev: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
