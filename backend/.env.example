# Copiar a .env y completar. NUNCA versionar .env.
API_ADDR=127.0.0.1:8080
RUST_LOG=api=info

# Postgres (local: `infra/db/db.sh url`). Usar puerto 5432 en Supabase (directo o pooler en
# modo session). El usuario debe poder `SET ROLE authenticated` (RLS); se verifica al arrancar.
DATABASE_URL=

# Clave para firmar los access tokens (HS256). Mínimo 32 bytes:
#   openssl rand -base64 48
APP_JWT_SECRET=
# Vida del access token en minutos (por defecto 15) y del refresh token en días (por defecto 7).
# ACCESS_TOKEN_MIN=15
# REFRESH_TOKEN_DIAS=7

# Cookie del refresh token: Secure por defecto (los navegadores lo aceptan en http://localhost).
# COOKIE_SECURE=true
# COOKIE_PATH=/
# Solo detrás de HTTPS:
# HSTS=true

# Orígenes del frontend permitidos (coma). Con el proxy de Vite no hace falta en desarrollo.
CORS_ALLOWED_ORIGINS=http://localhost:5173
